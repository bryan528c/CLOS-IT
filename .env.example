# Copy to .env locally and enter values yourself. Never paste secrets into chat/Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret for named asset finalization/generated media/AI budget RPCs. Optional for ordinary DB save/read.
SUPABASE_SERVER_KEY=
OPENAI_API_KEY=
DECART_API_KEY=
APP_ORIGIN=http://127.0.0.1:4311
AI_MODE=mock
LIVE_API_ENABLED=false
# Optional absolute paths if ffprobe/ffmpeg are not on PATH.
FFPROBE_PATH=
FFMPEG_PATH=
# Monetary/time/asset approvals live in sc_execution_approvals, not client parameters.
# No default approval, dollar amount, provider healthcheck or automatic seed/import.
